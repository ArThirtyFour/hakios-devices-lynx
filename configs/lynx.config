# HakiOS fragment: the Google Pixel 7a (lynx) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="lynx"
# CONFIG_UFS is not set
CONFIG_FIRMWARE="none"
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
CONFIG_HAKIOS_LYNX_TOUCH=y
CONFIG_HAKIOS_LYNX_BATTERY=y
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_LYNX_BT=y
# audio: the AoC (drivers/aoc, aoc=N) and the two CS35L41s (drivers/audio, amp=N). Both idle without their boot-args;
# aocsound=1 needs a Trusty client (lynx_trusty_aoc_cmd, not ported yet) to cold-start the AoC on gs201.
# (the AoC needs the Trusty client lynx_trusty_aoc_cmd first: without it the kernel does not link; until that is in,
# only the amplifiers are built)
# CONFIG_HAKIOS_LYNX_AOC=y
CONFIG_HAKIOS_LYNX_AMP=y
# The Pixel 7a's Mali-G710 driver (drivers/gpu/conf names it AKITA_MALI, not LYNX_MALI: the akita-port HakiOS tree
# leaves its stand-ins out by HAKIOS_AKITA_MALI, and a Mali service under another name would meet them at link time).
# mali_keep=1 (a boot argument) keeps the GPU on for HakiosGPU; without it the driver only runs its probe steps.
CONFIG_HAKIOS_AKITA_MALI=y
